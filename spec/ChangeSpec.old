---- MODULE ChangeSpec ----
EXTENDS Integers, FiniteSets, Sequences, TLC

\* Tiny abstract model of the DCIM change-spec workflow.
\* Goal: history is append-only and only advanced by Commit.

CONSTANTS
  Assets,          \* set of asset ids, e.g. {a1}
  MaxHistory       \* bound so TLC stays finite, e.g. 3

ASSUME Cardinality(Assets) > 0
ASSUME MaxHistory \in Nat \ {0}

\* PatchStatus: none | modified | staged | committed
\* (pending_billing omitted for the first skeleton)

(*--algorithm ChangeSpec
variables
  \* Current head of each asset's append-only ledger.
  historyId = [a \in Assets |-> 1],
  \* Working patch per asset: status and the history id it was based on.
  patchStatus = [a \in Assets |-> "none"],
  patchBase   = [a \in Assets |-> 0],
  \* Whether the (single) change spec currently holds the asset's patch.
  staged = [a \in Assets |-> FALSE];

define
  TypeOK ==
    /\ historyId \in [Assets -> 1..MaxHistory]
    /\ patchStatus \in [Assets -> {"none", "modified", "staged", "committed"}]
    /\ patchBase \in [Assets -> 0..MaxHistory]
    /\ staged \in [Assets -> BOOLEAN]

  \* History ids only move forward.
  HistoryAppendOnly ==
    \A a \in Assets: historyId[a] \in 1..MaxHistory

  \* A staged patch is always in the change spec; committed/none are not.
  StagingConsistent ==
    \A a \in Assets:
      staged[a] <=> (patchStatus[a] = "staged")

  \* You only commit what was staged, and only against the current head.
  Inv ==
    /\ TypeOK
    /\ StagingConsistent
end define;

\* Save a local edit without validation / staging.
macro Save(a) begin
  if patchStatus[a] \in {"none", "modified", "committed"} then
    patchStatus[a] := "modified";
    patchBase[a]   := historyId[a];
    staged[a]      := FALSE;
  end if;
end macro;

\* Attach the working patch to the change spec.
macro Stage(a) begin
  if patchStatus[a] = "modified" then
    patchStatus[a] := "staged";
    staged[a]      := TRUE;
  end if;
end macro;

\* Apply a staged patch: append a new history row (if under the bound).
macro Commit(a) begin
  if /\ patchStatus[a] = "staged"
     /\ patchBase[a] = historyId[a]
     /\ historyId[a] < MaxHistory
  then
    historyId[a]   := historyId[a] + 1;
    patchStatus[a] := "committed";
    staged[a]      := FALSE;
  end if;
end macro;

\* Stale base: staging is fine, but commit must refuse (no history bump).
macro CommitStaleIgnored(a) begin
  if /\ patchStatus[a] = "staged"
     /\ patchBase[a] # historyId[a]
  then
    skip;  \* optimistic concurrency reject
  end if;
end macro;

begin
  while TRUE do
    with a \in Assets do
      either
        Save(a);
      or
        Stage(a);
      or
        Commit(a);
      or
        CommitStaleIgnored(a);
      end either;
    end with;
  end while;
end algorithm; *)
====
